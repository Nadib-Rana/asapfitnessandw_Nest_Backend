// This is your Prisma schema file for the NestJS Backend Template.
// Replace the User and VerificationToken models with your application schema.
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// NOTE: In Prisma 7, the database URL is configured in prisma.config.ts
// not in the schema file. See prisma.config.ts at the project root.
datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — add your application enums here
// ============================================================

enum UserRole {
  user
  admin
}

enum TokenType {
  email_verification
  password_reset
}

// ============================================================
// MODELS — replace with your application models
// ============================================================

/// Base user model.
/// Extend with profile fields, relations, etc. as needed.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  role       UserRole @default(user)
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  verificationTokens VerificationToken[]

  @@map("users")
}

/// Token used for email verification and password reset flows.
model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("verification_tokens")
  @@index([token])
  @@index([userId, type, used])
}